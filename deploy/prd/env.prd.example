# Safe PRD environment *example* shipped inside the deploy bundle.
# Copy to /srv/docker/croniu-prd/deploy/prd/.env.prd on the server and fill secrets there.
# This filename intentionally does NOT match .env.* so packaging keeps it.
# Never put real secrets, tokens, PATs, or private keys in this file.

POSTGRES_USER=croniu
POSTGRES_PASSWORD=change-me-on-server
POSTGRES_DB=croniu
# Exclusive PRD loopback ports.
API_HOST_PORT=19080
WEB_HOST_PORT=14000
ADMIN_HOST_PORT=14002

CRONIU_ENV=production
SECRET_KEY=change-me-to-a-long-random-secret-on-server
SESSION_COOKIE_NAME=croniu_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
ADMIN_SESSION_COOKIE_NAME=croniu_admin_session
ADMIN_SESSION_TTL_HOURS=8
CORS_ORIGINS=https://app.croniu.com.br,https://admin.croniu.com.br
OPENAPI_ENABLED=false
TRUST_PROXY=true
TRUSTED_PROXY_IPS=127.0.0.1,::1

PUBLIC_APP_BASE_URL=https://app.croniu.com.br
APP_PUBLIC_URL=https://app.croniu.com.br
API_PUBLIC_URL=https://api.croniu.com.br
ADMIN_PUBLIC_URL=https://admin.croniu.com.br

# EMAIL_PROVIDER is the explicit outbound-email switch (matches backend):
#   fake|test|noop → email disabled (RESEND_API_KEY not required)
#   resend         → email enabled (real RESEND_API_KEY required; no placeholders)
EMAIL_PROVIDER=fake
RESEND_API_KEY=
EMAIL_FROM="Croniu <no-reply@send.croniu.com.br>"
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_REQUIRED=false
AUTH_RATE_LIMIT_PER_MINUTE=10

ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENVIRONMENT=production
BILLING_ENABLED=false
BILLING_CHECKOUT_ENABLED=false

AI_ENABLED=false
LLM_PROVIDER=fake
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Cloudflare Tunnel (optional; Compose profile "edge" only).
# External secret — leave empty for loopback-first deploy. Never commit a real token.
# Required only when starting: docker compose ... --profile edge up -d cloudflared
# Mapped to the official cloudflared process env TUNNEL_TOKEN (never put the token on argv).
# Placeholder below is intentionally non-secret and must be replaced on the server, or left empty.
CLOUDFLARE_TUNNEL_TOKEN=
