# Copy to /srv/docker/croniu-prd/deploy/prd/.env.prd and set values on the server.
# Never commit real secrets. Empty values here are intentional.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
API_HOST_PORT=18080
WEB_HOST_PORT=13000
ADMIN_HOST_PORT=13002

CRONIU_ENV=production
SECRET_KEY=
SESSION_COOKIE_NAME=croniu_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
ADMIN_SESSION_COOKIE_NAME=croniu_admin_session
ADMIN_SESSION_TTL_HOURS=8
CORS_ORIGINS=https://app.croniu.com.br,https://admin.croniu.com.br
OPENAPI_ENABLED=false
TRUST_PROXY=true
TRUSTED_PROXY_IPS=127.0.0.1,::1

PUBLIC_APP_BASE_URL=https://app.croniu.com.br
APP_PUBLIC_URL=https://app.croniu.com.br
API_PUBLIC_URL=https://api.croniu.com.br
ADMIN_PUBLIC_URL=https://admin.croniu.com.br

EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Croniu <no-reply@croniu.com.br>
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_REQUIRED=true
AUTH_RATE_LIMIT_PER_MINUTE=10

ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENVIRONMENT=production
BILLING_ENABLED=true
BILLING_CHECKOUT_ENABLED=true

AI_ENABLED=false
LLM_PROVIDER=fake
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
