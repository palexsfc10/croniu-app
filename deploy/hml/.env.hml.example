# Copie para /srv/docker/croniu/.env.hml no Jarvis. Nunca versione o arquivo real.

CRONIU_ENV=hml
CRONIU_VERSION=0.1.0

POSTGRES_USER=croniu_hml
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=croniu_hml

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
SESSION_COOKIE_NAME=croniu_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Origens do frontend de HML (ajuste após inventário de portas/domínios)
CORS_ORIGINS=http://127.0.0.1:WEB_HOST_PORT,http://localhost:WEB_HOST_PORT,http://127.0.0.1:ADMIN_HOST_PORT,http://localhost:ADMIN_HOST_PORT
OPENAPI_ENABLED=true
ADMIN_SESSION_COOKIE_NAME=croniu_admin_session
ADMIN_SESSION_TTL_HOURS=8

# Portas no host — escolher livres no preflight do Jarvis
API_HOST_PORT=18080
WEB_HOST_PORT=13000
ADMIN_HOST_PORT=13002

# Imagens locais construídas no Jarvis
CRONIU_API_IMAGE=croniu-hml-api:local
CRONIU_WEB_IMAGE=croniu-hml-web:local
CRONIU_ADMIN_IMAGE=croniu-hml-admin:local

# URLs públicas futuras (não configurar DNS sem confirmação)
# NEXT_PUBLIC_API_URL=https://api-hml.croniu.com
# NEXT_PUBLIC_APP_URL=https://hml.croniu.com
# Admin pretendido: admin-hml.croniu.com.br
NEXT_PUBLIC_API_URL=http://127.0.0.1:18080
NEXT_PUBLIC_APP_URL=http://127.0.0.1:13000
NEXT_PUBLIC_ADMIN_URL=http://127.0.0.1:13002

# Base pública usada nos callbacks Asaas (return/cancel/expired)
PUBLIC_APP_BASE_URL=http://127.0.0.1:13000

# --- Billing SaaS (Asaas Croniu — NUNCA reusar keys Kyvora) ---
ASAAS_API_KEY=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENVIRONMENT=sandbox
BILLING_GRACE_PERIOD_DAYS=3
BILLING_DEFAULT_AMOUNT_CENTS=2990
BILLING_ENABLED=true
BILLING_CHECKOUT_ENABLED=true
# Guard obrigatório até HML sandbox Croniu validado com evidências próprias
BILLING_CARD_ENABLED=false
BILLING_SANDBOX_ALLOWLIST_ORG_IDS=
BILLING_CHECKOUT_MINUTES_TO_EXPIRE=60
BILLING_CHECKOUT_RATE_LIMIT_MAX=5
BILLING_CHECKOUT_RATE_LIMIT_WINDOW_SECONDS=300
TRIAL_DAYS=7

# --- Assistente IA V1 (chave só no servidor; nunca no Git) ---
AI_ENABLED=false
LLM_PROVIDER=openai_responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
AI_STORE_RESPONSES=false
AI_MAX_INPUT_CHARS=4000
AI_MAX_TOOL_ROUNDS=6
AI_REQUEST_TIMEOUT_SECONDS=30
AI_USER_REQUESTS_PER_MINUTE=6
AI_ORG_DAILY_REQUEST_LIMIT=200
AI_CONFIRMATION_TTL_SECONDS=600

# Entrada por voz (HML: habilitar só após preflight/smoke)
VOICE_ENABLED=false
OPENAI_TRANSCRIPTION_MODEL=whisper-1
VOICE_MAX_SECONDS=60
VOICE_MAX_BYTES=4194304
VOICE_ALLOWED_MIME_TYPES=audio/webm,audio/webm;codecs=opus,audio/mp4,audio/mpeg,audio/wav,audio/x-wav,audio/ogg,audio/ogg;codecs=opus,video/webm
VOICE_TIMEOUT_SECONDS=45
VOICE_USER_REQUESTS_PER_MINUTE=4
VOICE_ORG_DAILY_REQUEST_LIMIT=80
VOICE_COST_PER_MINUTE_CENTS=0.6

# --- Transactional e-mail (HML contract; never paste PRD secrets) ---
# Prefer EMAIL_PROVIDER=fake for local/Jarvis smoke without Resend.
# When EMAIL_PROVIDER=resend, use a verified sender for this environment only.
EMAIL_PROVIDER=fake
EMAIL_FROM=Croniu HML <no-reply@send.croniu.com.br>
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_SECONDS=10
# Soft-gate: HML allows login without verified e-mail (AUDIT_RC2).
# Production must keep EMAIL_VERIFICATION_REQUIRED=true (fail-closed).
EMAIL_VERIFICATION_REQUIRED=false
# Public app origin used in verification/reset links (must not be app.croniu.com.br)
APP_PUBLIC_URL=http://127.0.0.1:13000
API_PUBLIC_URL=http://127.0.0.1:18080
ADMIN_PUBLIC_URL=http://127.0.0.1:13002
