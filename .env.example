# Croniu — ambiente de desenvolvimento (exemplo)
# Copie para .env e ajuste. Nunca versione secrets reais.

# PostgreSQL (Compose local)
POSTGRES_USER=croniu
POSTGRES_PASSWORD=croniu_dev_password_change_me
POSTGRES_DB=croniu
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# API
CRONIU_ENV=development
API_HOST=0.0.0.0
API_PORT=8010
DATABASE_URL=postgresql+psycopg://croniu:croniu_dev_password_change_me@localhost:5433/croniu
SECRET_KEY=dev-only-change-me-to-a-long-random-string-at-least-32-chars
# HMAC key for reconstructable client-portal URLs (v1.{access_id}.{mac}).
# Required in HML and PRD (min 32 characters). Leave empty in development:
# the API derives a fallback from SECRET_KEY (dev/tests only).
# Changing this key invalidates signed URLs immediately. Legacy token_hash
# links keep working until rotate/revoke. Never reuse the HML key in PRD.
# Never commit a real value.
CLIENT_PORTAL_SIGNING_KEY=
SESSION_COOKIE_NAME=croniu_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://127.0.0.1:3010,http://localhost:3002,http://127.0.0.1:3002
OPENAPI_ENABLED=true
ADMIN_SESSION_COOKIE_NAME=croniu_admin_session
ADMIN_SESSION_TTL_HOURS=8

# Web (Next.js profissionais) — browser usa /api same-origin (rewrite → API)
API_PROXY_TARGET=http://127.0.0.1:8010
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin (Next.js plataforma) — hostname pretendido a confirmar: admin.croniu.com.br
ADMIN_PORT=3002
PUBLIC_APP_BASE_URL=http://localhost:3010
PROOF_STORAGE_DIR=var/proofs
PUBLIC_RATE_LIMIT_PER_MINUTE=60
MAX_PROOF_BYTES=5242880

# Assistente IA (desativado por padrão — não coloque chaves reais neste arquivo)
AI_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
LLM_API_BASE=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_STEPS=6
LLM_MAX_INPUT_CHARS=4000
AI_RATE_LIMIT_PER_HOUR=60
AI_PENDING_ACTION_TTL_MINUTES=15
AI_CONFIRMATION_TTL_SECONDS=600
AI_STORE_RESPONSES=false
AI_USER_REQUESTS_PER_MINUTE=6
AI_ORG_DAILY_REQUEST_LIMIT=200
AI_ORG_MONTHLY_TOKEN_LIMIT=
LLM_INPUT_TOKEN_COST_PER_1K=0
LLM_OUTPUT_TOKEN_COST_PER_1K=0

# Entrada por voz (STT) — desativada por padrão; áudio nunca é persistido
VOICE_ENABLED=false
OPENAI_TRANSCRIPTION_MODEL=whisper-1
VOICE_MAX_SECONDS=60
VOICE_MAX_BYTES=4194304
VOICE_ALLOWED_MIME_TYPES=audio/webm,audio/webm;codecs=opus,audio/mp4,audio/mpeg,audio/wav,audio/x-wav,audio/ogg,audio/ogg;codecs=opus,video/webm
VOICE_TIMEOUT_SECONDS=45
VOICE_USER_REQUESTS_PER_MINUTE=4
VOICE_ORG_DAILY_REQUEST_LIMIT=80
VOICE_COST_PER_MINUTE_CENTS=0.6

# SaaS billing / Asaas (conta própria do Croniu — NÃO reutilizar secrets Kyvora)
# Separado de OrganizationPaymentSettings (Pix do aluno).
TRIAL_DAYS=7
ASAAS_API_KEY=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENVIRONMENT=sandbox
BILLING_GRACE_PERIOD_DAYS=3
BILLING_DEFAULT_AMOUNT_CENTS=2990
BILLING_ENABLED=true
BILLING_CHECKOUT_ENABLED=true
BILLING_CARD_ENABLED=false
BILLING_SANDBOX_ALLOWLIST_ORG_IDS=
BILLING_CHECKOUT_MINUTES_TO_EXPIRE=60
BILLING_CHECKOUT_RATE_LIMIT_MAX=5
BILLING_CHECKOUT_RATE_LIMIT_WINDOW_SECONDS=300

# E-mail transacional (fake em local/testes; Resend em PRD)
EMAIL_PROVIDER=fake
RESEND_API_KEY=
EMAIL_FROM=Croniu <no-reply@send.croniu.com.br>
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_REQUIRED=false
AUTH_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://127.0.0.1:8010
ADMIN_PUBLIC_URL=http://localhost:3002

# Login com Google (OpenID Connect via Google Identity Services). Desativado
# por padrão em todo ambiente — GOOGLE_OAUTH_ENABLED=true exige
# GOOGLE_OAUTH_CLIENT_ID preenchido (o backend recusa subir sem isso).
# Não há client secret neste fluxo: o navegador recebe um ID token assinado
# pelo Google e o backend o valida diretamente (audience = este client ID).
# O Client ID não é segredo — é o mesmo valor usado no frontend
# (NEXT_PUBLIC_GOOGLE_CLIENT_ID, apps/web/apps/admin, definido em build-time).
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
